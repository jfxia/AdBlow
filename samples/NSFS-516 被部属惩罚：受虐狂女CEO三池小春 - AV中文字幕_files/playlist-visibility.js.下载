(() => {
  'use strict';
  const style = document.createElement('style');
  style.textContent = '.sm-visibility{grid-column:1/-1;margin:0;padding:0;border:0}.sm-visibility legend{margin-bottom:8px;color:var(--sm-text);font-weight:800}.sm-visibility>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.sm-visibility label{display:flex;min-width:0;align-items:center;gap:10px;padding:11px 12px;border:1px solid var(--sm-line);border-radius:10px;background:var(--sm-bg);color:var(--sm-text);cursor:pointer}.sm-visibility label:has(input:checked){border-color:var(--sm-accent);box-shadow:inset 0 0 0 1px var(--sm-accent)}.sm-visibility input{width:16px!important;height:16px;min-width:16px;padding:0!important;accent-color:var(--sm-accent)}.sm-visibility span{display:grid;min-width:0}.sm-visibility b{font-size:14px}.sm-visibility small{color:var(--sm-muted);font-size:12px}@media(max-width:560px){.sm-visibility>div{grid-template-columns:1fr}}';
  document.head.appendChild(style);

  function enhance(form) {
    if (!form || form.dataset.visibilityReady === '1') return;
    form.dataset.visibilityReady = '1';
    const submit = form.querySelector('button');
    const fieldset = document.createElement('fieldset');
    const defaultPublic = /^(?:txxx|vjav|hdavx|hotavx|xhamster|missav|123av|jable|javeve|supjav|0[1-9]|1[0-9])$/.test(window.__MEMBER_PROJECT__ || document.body.dataset.memberProject || '');
    fieldset.className = 'sm-visibility';
    fieldset.innerHTML = '<legend>分享设定</legend><div><label><input type="radio" name="is_public" value="0" checked><span><b>私有片单</b><small>仅自己可见，适合个人收藏整理</small></span></label><label><input type="radio" name="is_public" value="1"><span><b>公开片单</b><small>其他会员可以浏览和分享</small></span></label></div>';
    if (defaultPublic) fieldset.querySelector('input[value="1"]').checked = true;
    form.insertBefore(fieldset, submit);
    if (submit) submit.textContent = '创建片单';
    form.onsubmit = async event => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      data.is_public = Number(data.is_public === '1');
      if (submit) submit.disabled = true;
      try {
        const response = await fetch('/member-api/playlists/save', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || payload.status !== 'success') throw new Error(payload.message || '创建片单失败');
        location.reload();
      } catch (error) {
        alert(error.message || '创建片单失败');
        if (submit) submit.disabled = false;
      }
    };
  }

  const scan = () => document.querySelectorAll('form.sm-create').forEach(enhance);
  scan();
  new MutationObserver(scan).observe(document.documentElement, { childList: true, subtree: true });
})();
