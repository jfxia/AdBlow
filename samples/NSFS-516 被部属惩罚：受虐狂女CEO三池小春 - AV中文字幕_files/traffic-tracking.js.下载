            } catch (_) {}
        });
    }
    w.addEventListener('site:traffic-ready', function (event) { update(event.detail); });
    if (w.__SITE_TRAFFIC_DATA__) update(w.__SITE_TRAFFIC_DATA__);
    function trackLegacyLink(event) {
        var anchor = event.target.closest && event.target.closest('a[href]');
        if (!anchor) return;
        var replacement = partners.get(anchor.href);
        if (replacement) anchor.href = replacement;
    }
    d.addEventListener('click', trackLegacyLink, true);
    d.addEventListener('auxclick', trackLegacyLink, true);
})(window, document);
