{
  "name": "adblow",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "description": "AdBlow —— 自研 MV3 广告过滤器：行为检测 + 自学习规则 + EasyList 系过滤列表。",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node tests/run-all.ts",
    "typecheck": "tsc --noEmit",
    "filters": "node tools/filters/fetch-lists.mjs",
    "rulesets": "node tools/build/gen-rulesets.ts",
    "icons": "python tools/build/gen-icons.py",
    "build": "node tools/build/build.mjs",
    "verify": "node tools/build/build.mjs && node tests/run-all.ts",
    "package": "node tools/release/package.mjs",
    "verify:package": "node tools/release/verify-package.mjs",
    "update-lists": "node tools/release/update-lists.mjs",
    "version:bump": "node tools/release/version-bump.mjs",
    "release:auto": "node tools/release/auto-release.mjs",
    "release:github": "node tools/release/github-release.mjs",
    "recon": "node tools/recon/snapshot.mjs"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/chrome": "^0.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "jsdom": "^30.1.2",
    "rollup": "^4.64.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
