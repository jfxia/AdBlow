flowchart TD
  start["document_start"] --> a["MAIN world: install guards, apply scriptlets, receive domain lists"]
  a --> b["isolated world: take a pristine snapshot of the document"]
  b --> c["requests match the static DNR rulesets"]
  c --> d["scan: site packs, list hiding rules, behaviour scoring"]
  d --> e{"judged an ad?"}
  e -->|"no"| g["leave it alone"]
  e -->|"yes"| f["hide via display, visibility, pointer-events and record the reason"]
  f --> h["verify: re-hide after the site restores it"]
  h --> i["record the hit; after 3 hits promote to a rule for this site only"]
  i --> j["rule manager: inspect, revoke one, export"]
  f --> r{"did a playing video appear inside it?"}
  r -->|"yes, and nothing above it is ad-named"| r2["restore it and stop hiding it on this page"]
  r -->|"no"| r3["keep it hidden"]
