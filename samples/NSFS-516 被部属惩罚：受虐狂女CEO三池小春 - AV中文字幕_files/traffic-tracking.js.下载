(function (w, d) {
    'use strict';
    if (w.__trafficTrackingStarted) return;
    w.__trafficTrackingStarted = true;
    var ref = new URL(w.location.href).searchParams.get('ref');
    if (ref && ref.length <= 128) {
        // Do not carry ref onto internal links: only actual ref landing pages count.
        var endpoint = '/traffic/in?ref=' + encodeURIComponent(ref);
        if (!navigator.sendBeacon || !navigator.sendBeacon(endpoint, '')) {
            fetch(endpoint, { method: 'POST', credentials: 'same-origin', keepalive: true }).catch(function () {});
        }
    }
    var partners = new Map();
    function update(data) {
        partners.clear();
        var keys = ['link', 'tubiao', 'banner_top', 'banner_middle', 'banner_foot', 'poster', 'preroll', 'couplet', 'float_right', 'piaofu', 'piaofu_top'];
        var items = [];
        keys.forEach(function (key) { if (Array.isArray(data && data[key])) items = items.concat(data[key]); });
        items.forEach(function (link) {
